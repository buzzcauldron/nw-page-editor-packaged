#!/usr/bin/make -f

export DH_VERBOSE = 1

NWJS_VERSION ?= 0.44.4

%:
	dh $@

override_dh_auto_configure:
	@echo "No configuration needed"

override_dh_auto_build:
	@echo "No build step needed - this is a JavaScript/HTML application"
	@if [ ! -d nwjs ] || [ ! -f nwjs/nw ]; then \
		echo "Downloading NW.js v$(NWJS_VERSION)..."; \
		curl -fLSs -o nwjs-sdk-linux-x64.tar.gz "https://dl.nwjs.io/v$(NWJS_VERSION)/nwjs-sdk-v$(NWJS_VERSION)-linux-x64.tar.gz" || true; \
		if [ -f nwjs-sdk-linux-x64.tar.gz ]; then \
			tar -xzf nwjs-sdk-linux-x64.tar.gz; \
			mv nwjs-sdk-v$(NWJS_VERSION)-linux-x64 nwjs || true; \
			rm -f nwjs-sdk-linux-x64.tar.gz; \
		fi; \
	fi

override_dh_auto_install:
	# Install NW.js runtime
	if [ -d nwjs ]; then \
		mkdir -p debian/nw-page-editor/usr/lib/nw-page-editor; \
		cp -r nwjs debian/nw-page-editor/usr/lib/nw-page-editor/; \
	fi
	
	# Install application files
	mkdir -p debian/nw-page-editor/usr/share/nw-page-editor
	cp -r css html js node_modules plugins xsd xslt examples package.json \
		debian/nw-page-editor/usr/share/nw-page-editor/
	
	# Install launcher script (modified to use bundled NW.js)
	mkdir -p debian/nw-page-editor/usr/bin
	cat > debian/nw-page-editor/usr/bin/nw-page-editor << 'EOF'
#!/usr/bin/env bash
(set -o igncr) 2>/dev/null && set -o igncr; # ignore \r line endings

##
## Command line launcher for nw-page-editor.
## This version uses the bundled NW.js runtime.
##

readlinkf() { perl -MCwd -e 'foreach $line ( <STDIN> ) { $line =~ s/\s+$//; print Cwd::abs_path($line) . "\n"; }'; }

[ "${nw_page_editor:-}" = "" ] &&
  nw_page_editor=$(echo "$0" | readlinkf | sed "s|/bin/${0##*/}$||");
[ ! -f "$nw_page_editor/js/nw-app.js" ] && [ -f "$nw_page_editor/share/nw-page-editor/js/nw-app.js" ] &&
  nw_page_editor="$nw_page_editor/share/nw-page-editor";

# Use bundled NW.js if available, otherwise fall back to system PATH
if [ -f "/usr/lib/nw-page-editor/nwjs/nw" ]; then
  nw="/usr/lib/nw-page-editor/nwjs/nw"
elif [ -f "/usr/lib64/nw-page-editor/nwjs/nw" ]; then
  nw="/usr/lib64/nw-page-editor/nwjs/nw"
else
  # Fall back to system NW.js
  if [ $( uname | grep -ci darwin ) != 0 ]; then
    nw="/Applications/nwjs.app/Contents/MacOS/nwjs";
    [ ! -f "$nw" ] &&
      nw=$(mdfind nwjs.app | head -n 1)"/Contents/MacOS/nwjs";
  else
    nw=$(which nw);
  fi
fi

[ ! -f "$nw_page_editor/js/nw-app.js" ] &&
  echo "${0##*/}: error: unable to resolve the nw-page-editor app location" &&
  exit 1;
[ ! -f "$nw" ] &&
  echo "${0##*/}: error: unable find the NW.js binary" &&
  exit 1;

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  echo "Description: Simple app for visual editing of Page XML files";
  echo "Usage: ${0##*/} [page.xml]+ [pages_dir]+ [--list pages_list]+ [--css file.css]+ [--js file.js]+";
  exit 0;
fi

argv=( --wd "$(pwd)" "$@" );
argv=("${argv[@]/#-l/--list}");
argv=("${argv[@]/#--/++}");

"$nw" --disable-features=nw2 "$nw_page_editor" "${argv[@]}" 2>>/tmp/nw-page-editor.log;
EOF
	chmod +x debian/nw-page-editor/usr/bin/nw-page-editor
	
	# Install documentation
	mkdir -p debian/nw-page-editor/usr/share/doc/nw-page-editor
	cp README.md LICENSE.md debian/nw-page-editor/usr/share/doc/nw-page-editor/

override_dh_auto_clean:
	rm -rf nwjs nwjs-sdk-*.tar.gz
